{
  "name": "glyphweave",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "description": "Build-time Typst-to-web publishing pipeline for blog-ready HTML, TOC, manifests, and optional PDFs.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/EricYuan2007/Glyphweave.git"
  },
  "homepage": "https://github.com/EricYuan2007/Glyphweave#readme",
  "keywords": [
    "typst",
    "astro",
    "static-site",
    "html",
    "mathml",
    "pagefind"
  ],
  "scripts": {
    "glyphweave": "tsx packages/glyphweave/src/cli/index.ts",
    "build": "pnpm build:packages",
    "build:demo": "pnpm --filter example-astro-blog build",
    "check": "pnpm build:packages && pnpm lint && pnpm typecheck && pnpm check:astro && pnpm test",
    "lint": "eslint .",
    "pagefind:demo": "pnpm --filter example-astro-blog pagefind",
    "test": "vitest run --config tests/unit/config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:demo": "pnpm build:packages && pnpm glyphweave build --root examples/minimal && pnpm build:demo && pnpm pagefind:demo",
    "build:packages": "tsc -b packages/glyphweave packages/astro",
    "check:astro": "pnpm --filter example-astro-blog exec astro check",
    "test:e2e": "playwright test --config tests/browser/config.ts",
    "test:package": "pnpm build:packages && node tests/integration/verify-packages.mjs",
    "test:integration": "pnpm build:packages && node tests/integration/verify-integration.mjs",
    "benchmark": "pnpm build:packages && node tests/benchmarks/benchmark.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "node tests/integration/verify-native-math.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:cache": "node scripts/clean.mjs --cache",
    "pack:packages": "pnpm build:packages && node scripts/pack.mjs",
    "security:check": "pnpm audit --registry=https://registry.npmjs.org"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.14.0",
    "execa": "^10.2.1",
    "hast-util-to-html": "^9.0.6",
    "opentype.js": "2.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 100
  }
}
