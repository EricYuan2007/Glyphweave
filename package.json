{
  "name": "glyphweave",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "description": "Build-time Typst-to-web publishing pipeline for blog-ready HTML, TOC, manifests, and optional PDFs.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/EricYuan2007/Glyphweave.git"
  },
  "homepage": "https://github.com/EricYuan2007/Glyphweave#readme",
  "keywords": [
    "typst",
    "astro",
    "static-site",
    "html",
    "mathml",
    "pagefind"
  ],
  "scripts": {
    "glyphweave": "tsx packages/cli/src/index.ts",
    "build": "pnpm build:packages",
    "build:demo": "pnpm --filter example-astro-blog build",
    "check": "pnpm build:packages && pnpm lint && pnpm typecheck && pnpm check:astro && pnpm test",
    "lint": "eslint .",
    "pagefind:demo": "pnpm --filter example-astro-blog pagefind",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:demo": "pnpm build:packages && pnpm glyphweave build --root examples/minimal && pnpm build:demo && pnpm pagefind:demo",
    "build:packages": "tsc -b packages/schema packages/math-renderer packages/typst packages/html-adapter packages/core packages/astro packages/cli",
    "check:astro": "pnpm --filter example-astro-blog exec astro check",
    "test:e2e": "playwright test",
    "test:package": "pnpm build:packages && node scripts/verify-packages.mjs",
    "test:integration": "pnpm build:packages && node scripts/verify-integration.mjs",
    "benchmark": "pnpm build:packages && node scripts/benchmark.mjs",
    "audit": "pnpm audit --registry=https://registry.npmjs.org",
    "build:native": "cargo build --locked --manifest-path crates/typst-html/Cargo.toml --release",
    "test:native": "node scripts/verify-native-math.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.13.0",
    "execa": "^10.2.1",
    "opentype.js": "2.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
