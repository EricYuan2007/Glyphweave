---
import '@glyphweave/astro/styles/glyphweave-math.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/content.css'
import '../styles/components.css'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import CodeBlocks from '../components/CodeBlocks.astro'
import ImageLightbox from '../components/ImageLightbox.astro'

interface Props {
  title: string
  description?: string
  language?: string
  canonicalUrl?: string | null
  unlisted?: boolean
}

const { title, description = 'Glyphweave Astro example', language = 'zh-CN', canonicalUrl, unlisted = false } = Astro.props
const pageTitle = title === 'Glyphweave Blog' ? title : `${title} | Glyphweave Blog`
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {unlisted && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
    <CodeBlocks />
    <ImageLightbox />
  </body>
</html>
