---
import BaseLayout from '../layouts/BaseLayout.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<BaseLayout title="Search">
  <section class="page-shell" aria-labelledby="search-title">
    <h1 id="search-title">Search articles</h1>
    <form id="article-search" role="search" data-base={base}>
      <label for="search-query">Search query</label>
      <input id="search-query" name="q" type="search" required />
      <button type="submit">Search</button>
    </form>
    <p id="search-status" role="status"></p>
    <ul id="search-results"></ul>
    <noscript>Search requires JavaScript. Browse the archive instead.</noscript>
  </section>
</BaseLayout>
<script is:inline type="module" src={`${base}/scripts/search.js`}></script>
