{
  "extends": "./packages/tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "glyphweave": ["./packages/glyphweave/src/build/index.ts"],
      "glyphweave/schema": ["./packages/glyphweave/src/schema/index.ts"],
      "glyphweave/compiler": ["./packages/glyphweave/src/compiler/index.ts"],
      "glyphweave/html": ["./packages/glyphweave/src/html/index.ts"],
      "glyphweave/math": ["./packages/glyphweave/src/math/index.ts"],
      "glyphweave/artifacts": ["./packages/glyphweave/src/artifacts/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "eslint.config.js"],
  "exclude": [
    "node_modules",
    "dist",
    ".glyphweave",
    "**/dist/**",
    "**/node_modules/**",
    "**/.inkstack/**",
    "**/.glyphweave/**"
  ]
}
